<UserControl x:Class="SomeTexty.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A8A8A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Startup -->
            <TextBlock Text="STARTUP" Style="{StaticResource SectionHeader}" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start with Windows" Style="{StaticResource RowLabel}" />
                <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              Checked="OnStartupToggled" Unchecked="OnStartupToggled" />
            </Grid>

            <!-- Behavior -->
            <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}" Margin="0,18,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Auto-hide when clicking away" Style="{StaticResource RowLabel}" />
                <ToggleButton x:Name="AutoHideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              Checked="OnAutoHideToggled" Unchecked="OnAutoHideToggled" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Paste clipboard when opening" Style="{StaticResource RowLabel}" />
                <ToggleButton x:Name="ClipboardToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              Checked="OnClipboardToggled" Unchecked="OnClipboardToggled" />
            </Grid>

            <!-- Shortcut hint -->
            <TextBlock Text="Tip: press Ctrl+Shift+Space to open from anywhere."
                       Foreground="#FF6A6A6A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />

            <!-- Personal dictionary -->
            <TextBlock Text="PERSONAL DICTIONARY" Style="{StaticResource SectionHeader}" Margin="0,18,0,8" />
            <TextBlock Text="Words you've added so they aren't flagged as misspelled."
                       Foreground="#FF8A8A8A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Border CornerRadius="6" Background="#FF262626" BorderBrush="#FF3A3A3A" BorderThickness="1" Padding="4">
                <StackPanel x:Name="WordList" />
            </Border>
            <Button x:Name="ClearAllButton" Style="{StaticResource ActionButton}" Content="Clear all"
                    HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnClearAll" />

            <!-- About -->
            <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" Margin="0,18,0,8" />
            <TextBlock x:Name="AboutText" Foreground="#FF9A9A9A" FontSize="12" />
            <TextBlock FontSize="12" Margin="0,4,0,0">
                <Hyperlink NavigateUri="https://github.com/M0-kii/sometexty"
                           RequestNavigate="OnNavigate" Foreground="#FF6E9BE6"
                           TextDecorations="None">github.com/M0-kii/sometexty</Hyperlink>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
