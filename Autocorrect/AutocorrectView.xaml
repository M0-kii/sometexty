<UserControl x:Class="SomeTexty.Autocorrect.AutocorrectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Dark, flat action button. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Background" Value="#FF333333" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF6A6A6A" />
                                <Setter TargetName="bd" Property="Background" Value="#FF2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A misspelled-word chip. -->
        <Style x:Key="WordChip" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF0F0F0" />
            <Setter Property="Background" Value="#FF3A2A2A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#FF7A4A4A" BorderThickness="0,0,0,2"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A3535" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Input -->
        <Border Grid.Row="0" CornerRadius="6" Background="#FF2A2A2A"
                BorderBrush="#FF3A3A3A" BorderThickness="1">
            <TextBox x:Name="Input"
                     Background="Transparent"
                     Foreground="#FFE6E6E6"
                     CaretBrush="#FFE6E6E6"
                     BorderThickness="0"
                     Padding="8"
                     FontSize="13"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False"
                     TextChanged="OnInputChanged" />
        </Border>

        <!-- Status -->
        <TextBlock x:Name="Status" Grid.Row="1"
                   Margin="2,8,0,8" FontSize="12" Foreground="#FF8A8A8A" />

        <!-- Suggestions -->
        <ScrollViewer Grid.Row="2" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="Issues" />
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="FixAll" Style="{StaticResource ActionButton}"
                    Content="Fix all" Click="OnFixAll" />
            <Button x:Name="Copy" Style="{StaticResource ActionButton}"
                    Content="Copy" Click="OnCopy" />
        </StackPanel>
    </Grid>
</UserControl>
