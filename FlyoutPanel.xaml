<Window x:Class="SomeTexty.FlyoutPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SomeTexty"
        Width="360" Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True">

    <!-- Outer margin leaves room for the drop shadow to render. -->
    <Border Margin="12"
            CornerRadius="10"
            Background="#FF1F1F1F"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="SomeTexty"
                       Foreground="#FFE6E6E6"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Text="Tools go here."
                       Foreground="#FF8A8A8A"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
